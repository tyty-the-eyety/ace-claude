<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ComIbmMQInput.msgnode="ComIbmMQInput.msgnode" xmlns:ComIbmCompute.msgnode="ComIbmCompute.msgnode" xmlns:ComIbmMQOutput.msgnode="ComIbmMQOutput.msgnode" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:eflow="http://www.ibm.com/wbi/2005/eflow" xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility" nsURI="DB_ENRICH_MF.msgflow" nsPrefix="DB_ENRICH_MF.msgflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1" nodeLayoutStyle="RECTANGLE">
    <eSuperTypes href="http://www.ibm.com/wbi/2005/eflow#//FCMBlock"/>
    <translation xmi:type="utility:ConstantString" string="DB_ENRICH_MF"/>
    <colorGraphic16 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/DB_ENRICH_APP/icons/full/obj16/DB_ENRICH_MF.gif"/>
    <colorGraphic32 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/DB_ENRICH_APP/icons/full/obj30/DB_ENRICH_MF.gif"/>
    <composition>
      <!-- MQ Input: receives a JSON message containing a customerId -->
      <nodes xmi:type="ComIbmMQInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="100,200" queueName="INPUT.QUEUE" messageDomainProperty="JSON">
        <translation xmi:type="utility:ConstantString" string="INPUT.QUEUE"/>
      </nodes>
      <!-- route_by_tier: looks up tier from the customers table via ODBC (dataSource="PGDB"
           maps to an ODBC DSN in odbc.ini) and PROPAGATEs to the matching output terminal.
           computeMode="exception" tells ACE not to copy InputRoot into OutputRoot — the node
           has no reason to modify the message, so skipping that tree copy saves memory and
           CPU on every message. -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="400,200" computeExpression="esql://routine/#DB_ENRICH_MF_Compute.Main" computeMode="exception" dataSource="PGDB">
        <translation xmi:type="utility:ConstantString" string="route_by_tier"/>
      </nodes>
      <!-- Three output nodes — one per tier -->
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_3" location="700,80" queueName="PREMIUM.QUEUE">
        <translation xmi:type="utility:ConstantString" string="PREMIUM.QUEUE"/>
      </nodes>
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_4" location="700,200" queueName="STANDARD.QUEUE">
        <translation xmi:type="utility:ConstantString" string="STANDARD.QUEUE"/>
      </nodes>
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_5" location="700,320" queueName="UNKNOWN.QUEUE">
        <translation xmi:type="utility:ConstantString" string="UNKNOWN.QUEUE"/>
      </nodes>
      <!-- INPUT.QUEUE → route_by_tier -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_1" targetNode="FCMComposite_1_2" sourceNode="FCMComposite_1_1" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <!-- route_by_tier.out → PREMIUM.QUEUE -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_2" targetNode="FCMComposite_1_3" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <!-- route_by_tier.out1 → STANDARD.QUEUE -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_3" targetNode="FCMComposite_1_4" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.out1" targetTerminalName="InTerminal.in"/>
      <!-- route_by_tier.out2 → UNKNOWN.QUEUE -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_4" targetNode="FCMComposite_1_5" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.out2" targetTerminalName="InTerminal.in"/>
    </composition>
    <propertyOrganizer/>
    <stickyBoard/>
  </eClassifiers>
</ecore:EPackage>
