<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ComIbmMQInput.msgnode="ComIbmMQInput.msgnode" xmlns:ComIbmCompute.msgnode="ComIbmCompute.msgnode" xmlns:ComIbmMQOutput.msgnode="ComIbmMQOutput.msgnode" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:eflow="http://www.ibm.com/wbi/2005/eflow" xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility" nsURI="XML_JSON_MAPPING_MF.msgflow" nsPrefix="XML_JSON_MAPPING_MF.msgflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1" nodeLayoutStyle="RECTANGLE">
    <eSuperTypes href="http://www.ibm.com/wbi/2005/eflow#//FCMBlock"/>
    <translation xmi:type="utility:ConstantString" string="XML_JSON_MAPPING_MF"/>
    <colorGraphic16 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/XML_JSON_MAPPING_APP/icons/full/obj16/XML_JSON_MAPPING_MF.gif"/>
    <colorGraphic32 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/XML_JSON_MAPPING_APP/icons/full/obj30/XML_JSON_MAPPING_MF.gif"/>
    <composition>
      <!-- MQ Input: receives Order XML. messageDomainProperty="XMLNSC" forces the namespace-aware
           XML parser regardless of MQMD.Format, so namespace-qualified paths work in ESQL. -->
      <nodes xmi:type="ComIbmMQInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="100,140" queueName="INPUT.XML.QUEUE" messageDomainProperty="XMLNSC">
        <translation xmi:type="utility:ConstantString" string="INPUT.XML.QUEUE"/>
      </nodes>
      <!-- map_xml_to_json: transforms Order XML (urn:example:order:v1) to the target JSON
           structure. computeMode="message" because we are building a new OutputRoot. -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="400,140" computeExpression="esql://routine/#XML_JSON_MAPPING_MF_Compute.Main" computeMode="message">
        <translation xmi:type="utility:ConstantString" string="map_xml_to_json"/>
      </nodes>
      <!-- MQ Output: forwards the mapped JSON message -->
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_3" location="700,140" queueName="OUTPUT.JSON.QUEUE">
        <translation xmi:type="utility:ConstantString" string="OUTPUT.JSON.QUEUE"/>
      </nodes>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_1" targetNode="FCMComposite_1_2" sourceNode="FCMComposite_1_1" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_2" targetNode="FCMComposite_1_3" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
    </composition>
    <propertyOrganizer/>
    <stickyBoard/>
  </eClassifiers>
</ecore:EPackage>
