<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ComIbmMQInput.msgnode="ComIbmMQInput.msgnode" xmlns:ComIbmTryCatch.msgnode="ComIbmTryCatch.msgnode" xmlns:ComIbmCompute.msgnode="ComIbmCompute.msgnode" xmlns:ComIbmMQOutput.msgnode="ComIbmMQOutput.msgnode" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:eflow="http://www.ibm.com/wbi/2005/eflow" xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility" nsURI="MQ_ERRHANDLING_MF.msgflow" nsPrefix="MQ_ERRHANDLING_MF.msgflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1" nodeLayoutStyle="RECTANGLE">
    <eSuperTypes href="http://www.ibm.com/wbi/2005/eflow#//FCMBlock"/>
    <translation xmi:type="utility:ConstantString" string="MQ_ERRHANDLING_MF"/>
    <colorGraphic16 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/MQ_ERRHANDLING_APP/icons/full/obj16/MQ_ERRHANDLING_MF.gif"/>
    <colorGraphic32 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/MQ_ERRHANDLING_APP/icons/full/obj30/MQ_ERRHANDLING_MF.gif"/>
    <composition>
      <!-- MQ Input: reads from INPUT.QUEUE -->
      <nodes xmi:type="ComIbmMQInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="80,140" queueName="INPUT.QUEUE">
        <translation xmi:type="utility:ConstantString" string="INPUT.QUEUE"/>
      </nodes>
      <!-- TryCatch: wraps processing; catch terminal fires on any downstream exception -->
      <nodes xmi:type="ComIbmTryCatch.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="320,140">
        <translation xmi:type="utility:ConstantString" string="TryCatch"/>
      </nodes>
      <!-- Process: validates/transforms the message; THROWs on bad input -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_3" location="580,60" computeExpression="esql://routine/#MQ_ERRHANDLING_MF_Process.Main" computeMode="message">
        <translation xmi:type="utility:ConstantString" string="Process"/>
      </nodes>
      <!-- Success output -->
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_4" location="820,60" queueName="OUTPUT.QUEUE">
        <translation xmi:type="utility:ConstantString" string="OUTPUT.QUEUE"/>
      </nodes>
      <!-- HandleError: prepares caught exception message for error queue -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_5" location="580,220" computeExpression="esql://routine/#MQ_ERRHANDLING_MF_HandleError.Main" computeMode="message">
        <translation xmi:type="utility:ConstantString" string="HandleError"/>
      </nodes>
      <!-- Error queue: receives caught exceptions -->
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_6" location="820,220" queueName="ERROR.QUEUE">
        <translation xmi:type="utility:ConstantString" string="ERROR.QUEUE"/>
      </nodes>
      <!-- Dead letter queue: receives messages that fail at the MQInput node itself -->
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_7" location="320,360" queueName="DEADLETTER.QUEUE">
        <translation xmi:type="utility:ConstantString" string="DEADLETTER.QUEUE"/>
      </nodes>
      <!-- Happy path: Input -> TryCatch -> Process -> Output -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_1" targetNode="FCMComposite_1_2" sourceNode="FCMComposite_1_1" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_2" targetNode="FCMComposite_1_3" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.try" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_3" targetNode="FCMComposite_1_4" sourceNode="FCMComposite_1_3" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <!-- Error path: TryCatch catch -> HandleError -> Error queue -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_4" targetNode="FCMComposite_1_5" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.catch" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_5" targetNode="FCMComposite_1_6" sourceNode="FCMComposite_1_5" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <!-- Failure path: MQInput failure terminal -> Dead letter queue -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_6" targetNode="FCMComposite_1_7" sourceNode="FCMComposite_1_1" sourceTerminalName="OutTerminal.failure" targetTerminalName="InTerminal.in"/>
    </composition>
    <propertyOrganizer/>
    <stickyBoard/>
  </eClassifiers>
</ecore:EPackage>
