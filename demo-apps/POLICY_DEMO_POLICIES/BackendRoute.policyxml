<?xml version="1.0" encoding="UTF-8"?>
<policies>
  <policy policyType="HTTPRequest" policyName="BackendRoute" policyTemplate="HTTPRequest">
    <acceptSelfSignedCerts>false</acceptSelfSignedCerts>
    <endpointURL>http://localhost:7800/policy-backend</endpointURL>
    <endpointURLOverrideBehaviour>ProtocolHostPortAndPath</endpointURLOverrideBehaviour>
  </policy>
</policies>
