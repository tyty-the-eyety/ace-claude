CREATE COMPUTE MODULE DFDL_PARSE_MF_ToJson
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE dfdlCompany REFERENCE TO InputRoot.DFDL.Company;
		DECLARE empRef REFERENCE TO dfdlCompany.Employee[1];
		DECLARE i INTEGER 1;

		CREATE FIELD OutputRoot.JSON.Data;
		SET OutputRoot.JSON.Data.company.name = dfdlCompany.CompanyName;
		CREATE FIELD OutputRoot.JSON.Data.company.employees IDENTITY (JSON.Array)employees;

		WHILE LASTMOVE(empRef) DO
			SET OutputRoot.JSON.Data.company.employees.Item[i].empNo  = empRef.EmpNo;
			SET OutputRoot.JSON.Data.company.employees.Item[i].dept   = empRef.Dept;
			SET OutputRoot.JSON.Data.company.employees.Item[i].name   = empRef.EmpName;
			SET OutputRoot.JSON.Data.company.employees.Item[i].city   = empRef.Address.City;
			SET OutputRoot.JSON.Data.company.employees.Item[i].salary = empRef.Salary;
			MOVE empRef NEXTSIBLING REPEAT NAME;
			SET i = i + 1;
		END WHILE;

		RETURN TRUE;
	END;
END MODULE;
