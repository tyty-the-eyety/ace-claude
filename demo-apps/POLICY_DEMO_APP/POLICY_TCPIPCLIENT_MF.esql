CREATE COMPUTE MODULE POLICY_TCPIPCLIENT_MF_ToBlob

	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot.BLOB.BLOB = ASBITSTREAM(InputRoot.JSON ENCODING 546 CCSID 1208);
		RETURN TRUE;
	END;

END MODULE;

CREATE COMPUTE MODULE POLICY_TCPIPCLIENT_MF_BuildAck

	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		SET OutputRoot.Properties.ContentType = 'application/json';

		SET OutputRoot.JSON.Data.sent      = TRUE;
		SET OutputRoot.JSON.Data.transport = 'tcpip';

		RETURN TRUE;
	END;

END MODULE;
