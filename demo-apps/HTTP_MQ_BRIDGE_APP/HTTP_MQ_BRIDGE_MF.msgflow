<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ComIbmWSInput.msgnode="ComIbmWSInput.msgnode" xmlns:ComIbmTryCatch.msgnode="ComIbmTryCatch.msgnode" xmlns:ComIbmCompute.msgnode="ComIbmCompute.msgnode" xmlns:ComIbmMQOutput.msgnode="ComIbmMQOutput.msgnode" xmlns:ComIbmWSReply.msgnode="ComIbmWSReply.msgnode" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:eflow="http://www.ibm.com/wbi/2005/eflow" xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility" nsURI="HTTP_MQ_BRIDGE_MF.msgflow" nsPrefix="HTTP_MQ_BRIDGE_MF.msgflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1" nodeLayoutStyle="RECTANGLE">
    <eSuperTypes href="http://www.ibm.com/wbi/2005/eflow#//FCMBlock"/>
    <translation xmi:type="utility:ConstantString" string="HTTP_MQ_BRIDGE_MF"/>
    <colorGraphic16 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/HTTP_MQ_BRIDGE_APP/icons/full/obj16/HTTP_MQ_BRIDGE_MF.gif"/>
    <colorGraphic32 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/HTTP_MQ_BRIDGE_APP/icons/full/obj30/HTTP_MQ_BRIDGE_MF.gif"/>
    <composition>
      <!-- HTTP Input: accepts POST /bridge/submit with a JSON body -->
      <nodes xmi:type="ComIbmWSInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="80,160" URLSpecifier="/bridge/submit" messageDomainProperty="JSON">
        <translation xmi:type="utility:ConstantString" string="/bridge/submit"/>
      </nodes>
      <!-- TryCatch: wraps MQ processing; catch fires on any downstream exception -->
      <nodes xmi:type="ComIbmTryCatch.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="320,160">
        <translation xmi:type="utility:ConstantString" string="TryCatch"/>
      </nodes>
      <!-- BuildMQMsg: serialises the JSON body into a BLOB MQ message with MQMD headers -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_3" location="560,80" computeExpression="esql://routine/#HTTP_MQ_BRIDGE_MF_BuildMQMsg.Main" computeMode="message">
        <translation xmi:type="utility:ConstantString" string="BuildMQMsg"/>
      </nodes>
      <!-- MQ Output: puts the message to TARGET.QUEUE; fires out terminal on success -->
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_4" location="780,80" queueName="TARGET.QUEUE">
        <translation xmi:type="utility:ConstantString" string="TARGET.QUEUE"/>
      </nodes>
      <!-- SuccessReply: builds HTTP 202 Accepted JSON response -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_5" location="1000,80" computeExpression="esql://routine/#HTTP_MQ_BRIDGE_MF_SuccessReply.Main" computeMode="message">
        <translation xmi:type="utility:ConstantString" string="SuccessReply"/>
      </nodes>
      <!-- WSReply: sends the HTTP response back to the caller -->
      <nodes xmi:type="ComIbmWSReply.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_6" location="1220,160">
        <translation xmi:type="utility:ConstantString" string="reply"/>
      </nodes>
      <!-- ErrorReply: builds HTTP 500 JSON error response from ExceptionList -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_7" location="560,260" computeExpression="esql://routine/#HTTP_MQ_BRIDGE_MF_ErrorReply.Main" computeMode="message">
        <translation xmi:type="utility:ConstantString" string="ErrorReply"/>
      </nodes>
      <!-- Happy path: HTTPInput -> TryCatch -> BuildMQMsg -> MQOutput -> SuccessReply -> WSReply -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_1" targetNode="FCMComposite_1_2" sourceNode="FCMComposite_1_1" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_2" targetNode="FCMComposite_1_3" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.try" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_3" targetNode="FCMComposite_1_4" sourceNode="FCMComposite_1_3" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_4" targetNode="FCMComposite_1_5" sourceNode="FCMComposite_1_4" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_5" targetNode="FCMComposite_1_6" sourceNode="FCMComposite_1_5" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <!-- Error path: TryCatch catch -> ErrorReply -> WSReply (shared reply node) -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_6" targetNode="FCMComposite_1_7" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.catch" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_7" targetNode="FCMComposite_1_6" sourceNode="FCMComposite_1_7" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
    </composition>
    <propertyOrganizer/>
    <stickyBoard/>
  </eClassifiers>
</ecore:EPackage>
