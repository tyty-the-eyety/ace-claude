<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ComIbmMQInput.msgnode="ComIbmMQInput.msgnode" xmlns:ComIbmCollector.msgnode="ComIbmCollector.msgnode" xmlns:ComIbmCompute.msgnode="ComIbmCompute.msgnode" xmlns:ComIbmMQOutput.msgnode="ComIbmMQOutput.msgnode" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:eflow="http://www.ibm.com/wbi/2005/eflow" xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility" nsURI="MQ_COLLECTOR_MF.msgflow" nsPrefix="MQ_COLLECTOR_MF.msgflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1" nodeLayoutStyle="RECTANGLE">
    <eSuperTypes href="http://www.ibm.com/wbi/2005/eflow#//FCMBlock"/>
    <translation xmi:type="utility:ConstantString" string="MQ_COLLECTOR_MF"/>
    <colorGraphic16 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/MQ_COLLECTOR_APP/icons/full/obj16/MQ_COLLECTOR_MF.gif"/>
    <colorGraphic32 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/MQ_COLLECTOR_APP/icons/full/obj30/MQ_COLLECTOR_MF.gif"/>
    <composition>
      <nodes xmi:type="ComIbmMQInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="80,120" queueName="COLLECTOR.IN.A" messageDomainProperty="XMLNSC" policyUrl="{POLICY_DEMO_POLICIES}:DevQM">
        <translation xmi:type="utility:ConstantString" string="COLLECTOR.IN.A"/>
      </nodes>
      <nodes xmi:type="ComIbmMQInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="80,280" queueName="COLLECTOR.IN.B" messageDomainProperty="XMLNSC" policyUrl="{POLICY_DEMO_POLICIES}:DevQM">
        <translation xmi:type="utility:ConstantString" string="COLLECTOR.IN.B"/>
      </nodes>

      <!-- Collector: one dynamic input terminal per source, complete when 1 message arrived on each -->
      <nodes xmi:type="ComIbmCollector.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_3" location="380,200" collectionName="PairedEvents" configurableService="{POLICY_DEMO_POLICIES}:Collector">
        <translation xmi:type="utility:ConstantString" string="Collector"/>
        <inTerminals terminalNodeID="InTerminal.legA" dynamic="true" label="legA"/>
        <inTerminals terminalNodeID="InTerminal.legB" dynamic="true" label="legB"/>
        <eventHandlerPropertyTable terminal="legA" quantity="1" timeout="0"/>
        <eventHandlerPropertyTable terminal="legB" quantity="1" timeout="0"/>
      </nodes>

      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_4" location="680,200" computeExpression="esql://routine/#MQ_COLLECTOR_MF_BuildCombined.Main">
        <translation xmi:type="utility:ConstantString" string="BuildCombined"/>
      </nodes>

      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_5" location="980,200" queueName="COLLECTOR.OUT" policyUrl="{POLICY_DEMO_POLICIES}:DevQM">
        <translation xmi:type="utility:ConstantString" string="COLLECTOR.OUT"/>
      </nodes>

      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_1" sourceNode="FCMComposite_1_1" sourceTerminalName="OutTerminal.out" targetNode="FCMComposite_1_3" targetTerminalName="InTerminal.legA"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_2" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.out" targetNode="FCMComposite_1_3" targetTerminalName="InTerminal.legB"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_3" sourceNode="FCMComposite_1_3" sourceTerminalName="OutTerminal.out" targetNode="FCMComposite_1_4" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_4" sourceNode="FCMComposite_1_4" sourceTerminalName="OutTerminal.out" targetNode="FCMComposite_1_5" targetTerminalName="InTerminal.in"/>
    </composition>
    <propertyOrganizer/>
    <stickyBoard/>
  </eClassifiers>
</ecore:EPackage>
