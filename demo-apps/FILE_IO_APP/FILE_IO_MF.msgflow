<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ComIbmFileInput.msgnode="ComIbmFileInput.msgnode" xmlns:ComIbmTryCatch.msgnode="ComIbmTryCatch.msgnode" xmlns:ComIbmCompute.msgnode="ComIbmCompute.msgnode" xmlns:ComIbmFileOutput.msgnode="ComIbmFileOutput.msgnode" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:eflow="http://www.ibm.com/wbi/2005/eflow" xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility" nsURI="FILE_IO_MF.msgflow" nsPrefix="FILE_IO_MF.msgflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1" nodeLayoutStyle="RECTANGLE">
    <eSuperTypes href="http://www.ibm.com/wbi/2005/eflow#//FCMBlock"/>
    <translation xmi:type="utility:ConstantString" string="FILE_IO_MF"/>
    <colorGraphic16 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/FILE_IO_APP/icons/full/obj16/FILE_IO_MF.gif"/>
    <colorGraphic32 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/FILE_IO_APP/icons/full/obj30/FILE_IO_MF.gif"/>
    <composition>
      <!-- FileInput: polls /in for *.txt files; archives to /in/archive after reading -->
      <nodes xmi:type="ComIbmFileInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="80,160" inputDirectory="/tmp/ace-file-io/in" outputDirectory="/tmp/ace-file-io/in/archive" filePattern="*.txt">
        <translation xmi:type="utility:ConstantString" string="read_input_files"/>
      </nodes>
      <!-- TryCatch: wraps file processing; catch fires on any downstream exception -->
      <nodes xmi:type="ComIbmTryCatch.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="320,160">
        <translation xmi:type="utility:ConstantString" string="TryCatch"/>
      </nodes>
      <!-- process_file: transforms file content and sets the output filename -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_3" location="560,80" computeExpression="esql://routine/#FILE_IO_MF_ProcessFile.Main" computeMode="destinationAndMessage">
        <translation xmi:type="utility:ConstantString" string="process_file"/>
      </nodes>
      <!-- FileOutput: writes processed file to /out -->
      <nodes xmi:type="ComIbmFileOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_4" location="800,80" outputDirectory="/tmp/ace-file-io/out">
        <translation xmi:type="utility:ConstantString" string="write_processed"/>
      </nodes>
      <!-- handle_error: builds an error report file from the ExceptionList -->
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_5" location="560,260" computeExpression="esql://routine/#FILE_IO_MF_HandleError.Main" computeMode="destinationAndMessage">
        <translation xmi:type="utility:ConstantString" string="handle_error"/>
      </nodes>
      <!-- FileOutput: writes error report to /error (shared by catch and failure paths) -->
      <nodes xmi:type="ComIbmFileOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_6" location="800,260" outputDirectory="/tmp/ace-file-io/error">
        <translation xmi:type="utility:ConstantString" string="write_error"/>
      </nodes>
      <!-- Happy path: FileInput -> TryCatch -> process_file -> /out -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_1" targetNode="FCMComposite_1_2" sourceNode="FCMComposite_1_1" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_2" targetNode="FCMComposite_1_3" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.try" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_3" targetNode="FCMComposite_1_4" sourceNode="FCMComposite_1_3" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <!-- Error path: TryCatch catch -> handle_error -> /error -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_4" targetNode="FCMComposite_1_5" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.catch" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_5" targetNode="FCMComposite_1_6" sourceNode="FCMComposite_1_5" sourceTerminalName="OutTerminal.out" targetTerminalName="InTerminal.in"/>
      <!-- Failure path: FileInput failure (e.g. file locked/unreadable) -> /error -->
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_6" targetNode="FCMComposite_1_6" sourceNode="FCMComposite_1_1" sourceTerminalName="OutTerminal.failure" targetTerminalName="InTerminal.in"/>
    </composition>
    <propertyOrganizer/>
    <stickyBoard/>
  </eClassifiers>
</ecore:EPackage>
