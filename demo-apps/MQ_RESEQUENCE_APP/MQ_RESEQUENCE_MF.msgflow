      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_2" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.out" targetNode="FCMComposite_1_3" targetTerminalName="InTerminal.in"/>
