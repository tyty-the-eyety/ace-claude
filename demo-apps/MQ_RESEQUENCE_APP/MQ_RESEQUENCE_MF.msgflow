    <composition>
      <nodes xmi:type="ComIbmMQInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="80,140" queueName="RESEQUENCE.IN" messageDomainProperty="XMLNSC" policyUrl="{POLICY_DEMO_POLICIES}:DevQM">
