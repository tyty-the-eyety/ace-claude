<?xml version="1.0" encoding="UTF-8"?>
<policies>
  <policy policyType="MQEndpoint" policyName="DevQM" policyTemplate="MQEndpoint">
    <connection>SERVER</connection>
    <destinationQueueManagerName>TEST_QM</destinationQueueManagerName>
    <queueManagerHostname/>
    <listenerPortNumber>1414</listenerPortNumber>
    <channelName/>
    <CCDTUrl/>
    <securityIdentity/>
    <useSSL>false</useSSL>
    <SSLPeerName/>
    <SSLCipherSpec/>
    <SSLCertificateLabel/>
    <MQApplName/>
    <reconnectOption>default</reconnectOption>
  </policy>
</policies>
