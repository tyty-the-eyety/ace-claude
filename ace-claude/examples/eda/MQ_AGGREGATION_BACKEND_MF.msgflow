<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ComIbmMQInput.msgnode="ComIbmMQInput.msgnode" xmlns:ComIbmCompute.msgnode="ComIbmCompute.msgnode" xmlns:ComIbmMQOutput.msgnode="ComIbmMQOutput.msgnode" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:eflow="http://www.ibm.com/wbi/2005/eflow" xmlns:utility="http://www.ibm.com/wbi/2005/eflow_utility" nsURI="MQ_AGGREGATION_BACKEND_MF.msgflow" nsPrefix="MQ_AGGREGATION_BACKEND_MF.msgflow">
  <eClassifiers xmi:type="eflow:FCMComposite" name="FCMComposite_1" nodeLayoutStyle="RECTANGLE">
    <eSuperTypes href="http://www.ibm.com/wbi/2005/eflow#//FCMBlock"/>
    <translation xmi:type="utility:ConstantString" string="MQ_AGGREGATION_BACKEND_MF"/>
    <colorGraphic16 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/MQ_AGGREGATION_APP/icons/full/obj16/MQ_AGGREGATION_BACKEND_MF.gif"/>
    <colorGraphic32 xmi:type="utility:GIFFileGraphic" resourceName="platform:/plugin/MQ_AGGREGATION_APP/icons/full/obj30/MQ_AGGREGATION_BACKEND_MF.gif"/>
    <composition>
      <!-- Simulated backend for Leg A: echoes the request to its ReplyToQ, stamping CorrelId = request MsgId -->
      <nodes xmi:type="ComIbmMQInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_1" location="80,120" queueName="LEGA.REQUEST" messageDomainProperty="XMLNSC" policyUrl="{POLICY_DEMO_POLICIES}:DevQM">
        <translation xmi:type="utility:ConstantString" string="LEGA.REQUEST"/>
      </nodes>
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_2" location="380,120" computeExpression="esql://routine/#MQ_AGGREGATION_BACKEND_MF_EchoA.Main">
        <translation xmi:type="utility:ConstantString" string="EchoA"/>
      </nodes>
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_3" location="680,120" queueName="LEGA.REPLY" policyUrl="{POLICY_DEMO_POLICIES}:DevQM">
        <translation xmi:type="utility:ConstantString" string="LEGA.REPLY"/>
      </nodes>

      <!-- Simulated backend for Leg B -->
      <nodes xmi:type="ComIbmMQInput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_4" location="80,280" queueName="LEGB.REQUEST" messageDomainProperty="XMLNSC" policyUrl="{POLICY_DEMO_POLICIES}:DevQM">
        <translation xmi:type="utility:ConstantString" string="LEGB.REQUEST"/>
      </nodes>
      <nodes xmi:type="ComIbmCompute.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_5" location="380,280" computeExpression="esql://routine/#MQ_AGGREGATION_BACKEND_MF_EchoB.Main">
        <translation xmi:type="utility:ConstantString" string="EchoB"/>
      </nodes>
      <nodes xmi:type="ComIbmMQOutput.msgnode:FCMComposite_1" xmi:id="FCMComposite_1_6" location="680,280" queueName="LEGB.REPLY" policyUrl="{POLICY_DEMO_POLICIES}:DevQM">
        <translation xmi:type="utility:ConstantString" string="LEGB.REPLY"/>
      </nodes>

      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_1" sourceNode="FCMComposite_1_1" sourceTerminalName="OutTerminal.out" targetNode="FCMComposite_1_2" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_2" sourceNode="FCMComposite_1_2" sourceTerminalName="OutTerminal.out" targetNode="FCMComposite_1_3" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_3" sourceNode="FCMComposite_1_4" sourceTerminalName="OutTerminal.out" targetNode="FCMComposite_1_5" targetTerminalName="InTerminal.in"/>
      <connections xmi:type="eflow:FCMConnection" xmi:id="FCMConnection_4" sourceNode="FCMComposite_1_5" sourceTerminalName="OutTerminal.out" targetNode="FCMComposite_1_6" targetTerminalName="InTerminal.in"/>
    </composition>
    <propertyOrganizer/>
    <stickyBoard/>
  </eClassifiers>
</ecore:EPackage>
